{
  "name": "test-automation-skeleton",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "TEST_TAGS=smoke playwright test",
    "test:regression": "TEST_TAGS=regression playwright test",
    "testcases:export": "node scripts/sync-testcases.mjs export",
    "testcases:import": "node scripts/sync-testcases.mjs import",
    "testcases:check": "node scripts/sync-testcases.mjs import --check",
    "test:unit": "node --require ./scripts/register-typescript.cjs --test automation/unit/*.test.cjs automation/unit/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node --check scripts/summarize-results.mjs && node --check scripts/sync-testcases.mjs && npm run typecheck && npm run testcases:check && npm run test:unit",
    "test:quarantine": "TEST_QUARANTINE=1 playwright test",
    "report:summary": "node scripts/summarize-results.mjs",
    "test:overlays": "playwright test --config playwright.contracts.config.ts overlays.spec.ts",
    "test:contracts": "playwright test --config playwright.contracts.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
